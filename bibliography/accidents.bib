% Crossref (Computer 20(4):10-19, April 1987; Crossref omits the colon of the
% printed title and the author's given names; name: LoC authority "Brooks,
% Frederick P., Jr. (Frederick Phillips)").
%
% The sentence in which Brooks invokes Aristotle exists in three wordings:
% - Computer (1987), section "Does it have to be hard?—Essential difficulties",
%   per two transcriptions of the Computer text (B. Cox's annotated copy, marked
%   "Computer Magazine; April 1987", and the UCSF course copy, "IEEE Computer,
%   Vol. 20, No. 4 (April 1987) pp. 10-19"); the PAGE IS NOT VERIFIED (no scan of
%   the magazine was available):
%     "Following Aristotle, I divide them into essence, the difficulties inherent
%     in the nature of software, and accidents, those difficulties that today
%     attend its production but are not inherent."
% - The Mythical Man-Month, Anniversary Edition (1995), ch. 16, p. 182 (scan of the
%   book; reprints the IFIP 1986 text) — see brooks1995:
%     "Following Aristotle, I divide them into essence—the difficulties inherent in
%     the nature of the software—and accidents—those difficulties that today attend
%     its production but that are not inherent."
% - UNC technical report TR86-020 (1986), scan: "... essence, the difficulties
%   inherent in the nature of the software, and accidents, those difficulties which
%   today attend its production but which are not inherent."
% For a quotation with a page number, cite brooks1995 [p. 182].
@article{brooks1987,
  author   = {Brooks, Jr., Frederick Phillips},
  title    = {No silver bullet},
  subtitle = {essence and accidents of software engineering},
  journal  = {Computer},
  volume   = 20,
  number   = 4,
  pages    = {10--19},
  date     = {1987-04},
  doi      = {10.1109/MC.1987.1663532},
  langid   = {english},
}

