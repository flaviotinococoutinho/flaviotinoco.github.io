@comment{
  Bibliografia da camada "acidentes" (ferramentas, ontologia de domínio e
  metaprodutos) e dos ensaios que a usam. Mesmas convenções de
  bibliography/main.bib e de docs/guia-citacoes.md: só referências reais,
  títulos em caixa de sentença com nomes próprios e siglas entre chaves,
  prenomes por extenso quando documentados (catálogos de autoridade).

  Verificação em 2026-10-19: artigos com DOI contra o registro Crossref
  (api.crossref.org/works/<doi>), campo a campo; livros contra registros
  MARC de bibliotecas (Library of Congress, Universidade de Toronto,
  Columbia), o catálogo da BnF ou a própria publicação (folha de rosto e
  verso, digitalizados); o comentário de cada entrada diz qual. Os trechos
  citados nos comentários foram conferidos em digitalizações das edições
  indicadas, com a página impressa.

  Chaves: sobrenome + ano, exceto as duas obras de Aristóteles, cujas chaves
  (aristotle-categories, aristotle-metaphysics) nomeiam a obra porque as datas
  são das traduções, não da composição.
}

% Title page and copyright page (scan of the 2002 digital reprint, which keeps the
% 1963 pagination: "© Oxford University Press 1963 ... Reprinted 2002"): Aristotle,
% Categories and De Interpretatione, translated with notes by J. L. Ackrill,
% Clarendon Press, Oxford; Clarendon Aristotle Series. Catalogue (Toronto, Columbia,
% Harvard MARC via Open Library): Oxford, Clarendon Press, 1963, vi, 162 p.
% Translator's full name: British Academy memoir and BnF authority (John Lloyd Ackrill).
%
% Categories 2, 1a24-25, in Ackrill's rendering, p. 4 (the passage of 1a20-1b9):
%   "(b) Some are in a subject but are not said of any subject. (By 'in a subject'
%   I mean what is in something, not as a part, and cannot exist separately from
%   what it is in.)"
% Ackrill's wording is "in a subject", not "present in a subject". The example that
% follows on the same page: "the individual knowledge-of-grammar is in a subject,
% the soul, but is not said of any subject".
@book{aristotle-categories,
  author     = {Aristotle},
  title      = {{Categories} and {De Interpretatione}},
  translator = {Ackrill, John Lloyd},
  series     = {Clarendon Aristotle Series},
  address    = {Oxford},
  publisher  = {Clarendon Press},
  year       = 1963,
  langid     = {english},
}

