---
/**
 * Home page (one per locale).
 *
 *   hero      the claim of the site, what it covers, two ways in, the corpus in
 *             numbers — and, beside it, a live instrument: the flags lab in its
 *             compact form (<ft-lab-flags>), whose static picture after
 *             play() and pause() is what a reader without JavaScript sees
 *   scope     the five lines of inquiry with their core disciplines, generated
 *             from the scope model (ADR 0013), each with a recent work of its own
 *             (latestByAxis: a matching, so no work is shown under two lines)
 *   latest    the most recent essays of this locale (section omitted when empty)
 *   bridge    the four strata as a path, under the simplices in depth
 *             (<ft-depth-scene>), each with its guiding question and method
 *   teasers   lab, ontology and formulas
 *
 * Everything is static HTML and reads completely without JavaScript and with
 * reduced motion; scroll only adds parallax and a gentle reveal (motion.css).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimplexScene from '../../components/chrome/SimplexScene.astro';
import StratumMark from '../../components/chrome/StratumMark.astro';
import FlagsSnapshot from '../../components/labs/FlagsSnapshot.astro';
import { siteFormulas } from '../../components/formulas/data.ts';
import { siteScope } from '../../components/scope/data.ts';
import common from '../../core/i18n/catalogs/common.ts';
import chrome from '../../core/i18n/catalogs/chrome.ts';
import reading from '../../core/i18n/catalogs/reading.ts';
import scopeCatalog from '../../core/i18n/catalogs/scope.ts';
import { plural } from '../../core/i18n/messages.ts';
import { labElementModel } from '../../core/labs/embed.ts';
import { asset, formatDate, href, localeStaticPaths, useTranslations } from '../../adapters/astro/i18n.ts';
import {
  alternatesForAll,
  concepts,
  essays,
  labs,
  routeOfEssay,
  routeOfLab,
  strata,
} from '../../adapters/astro/content.ts';
import { localeCodec, type Locale } from '../../core/domain/locale.ts';
import { STRATA, STRATUM_SPECS } from '../../core/domain/strata.ts';
import { FORM_GLYPH } from '../../core/domain/facets.ts';
import { AXES, disciplinesOf, latestByAxis } from '../../core/domain/scope.ts';
import { runIn } from '../../core/chrome/runin.ts';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { readonly locale: Locale };
const t = useTranslations(common, locale);
const c = useTranslations(chrome, locale);
const r = useTranslations(reading, locale);

/** How many essays the home page lists; the full list lives in the essays index. */
const LATEST = 5;
/** How many labs the teaser names. */
const LAB_NAMES = 3;

const [strataEntries, latest, allLabs, allConcepts] = await Promise.all([
  strata(locale),
  essays(locale),
  labs(locale),
  concepts(),
]);
const bridge = STRATA.map((s) => {
  const entry = strataEntries.find((e) => e.data.stratum === s);
  if (entry === undefined) throw new Error(`[home] missing src/content/strata entry for ${s} (${locale})`);
  return { stratum: s, spec: STRATUM_SPECS[s], data: entry.data };
});
const sc = useTranslations(scopeCatalog, locale);
const [scope, formulas] = await Promise.all([siteScope(locale), siteFormulas()]);

/**
 * Lines of inquiry: disciplines and the most recent work matched to the line (latestByAxis): a work that declares
 * disciplines of two lines stands for one of them only; a line without any work says so by omission.
 */
const newest = latestByAxis(scope.works);
const axes = AXES.map((axis) => ({ axis, disciplines: disciplinesOf(axis), latest: newest[axis] }));

/** The corpus in numbers, each a way in. */
const count = (n: number, key: 'essays' | 'labs' | 'concepts' | 'formulas'): string =>
  plural(locale, n, { one: c(`home.stats.${key}.one`), other: c(`home.stats.${key}.other`) });
const stats = [
  { text: count(latest.length, 'essays'), href: href({ kind: 'essays' }, locale) },
  { text: count(allLabs.length, 'labs'), href: href({ kind: 'labs' }, locale) },
  { text: count(allConcepts.length, 'concepts'), href: href({ kind: 'ontology' }, locale) },
  { text: count(formulas.registry.formulas.length, 'formulas'), href: href({ kind: 'formulas' }, locale) },
];

/** The instrument of the hero: the flags lab, compact, with the essay it comes from. */
const flagsLab = allLabs.find((l) => l.data.widget === 'flags');
const flagsEssay = latest.find((e) => e.data.translationKey === 'the-second-flag');
if (flagsLab === undefined || flagsEssay === undefined) {
  throw new Error(`[home] the hero needs the lab "flags" and the essay "the-second-flag" (${locale})`);
}
const instrument = labElementModel('flags', locale, {
  state: '',
  link: { href: href(routeOfLab(flagsLab), locale), title: flagsLab.data.title },
  title: c('home.hero.instrument'),
});
const Instrument = instrument.tag;
const instrumentAttributes = { ...instrument.attributes, class: 'lab lab--hero' };

const recent = latest.slice(0, LATEST);
const labNames = allLabs.slice(0, LAB_NAMES);
const feed = asset(`${localeCodec.encode(locale)}/rss.xml`);
---

<BaseLayout
  locale={locale}
  title={t('site.name')}
  description={t('site.description')}
  alternates={alternatesForAll(() => ({ kind: 'home' }))}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title={c('feed.title')} href={feed} />

  <section class="hero page-grid" aria-labelledby="home-title">
    <ft-ambient-field
      class="hero__ambient"
      data-daypart-aware
      aria-hidden="true"
      role="presentation"
    ></ft-ambient-field>
    <div class="hero__text">
      <h1 id="home-title" class="hero__title">
        {c('home.hero.claim')}
      </h1>
      <p class="hero__lede">{c('home.hero.lede')}</p>
      <p class="hero__actions ui">
        <a class="hero__cta" href={href(routeOfEssay(flagsEssay), locale)}>
          {c('home.hero.read')}
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <use href="#ui-arrow"></use>
          </svg>
        </a>
        <a class="hero__more" href={href({ kind: 'scope' }, locale)}>
          {c('home.hero.scope')}
        </a>
      </p>
      <ul class="hero__stats ui" role="list" aria-label={c('home.stats.label')}>
        {stats.map((s) => (
          <li>
            <a href={s.href}>{s.text}</a>
          </li>
        ))}
      </ul>
    </div>
    <div class="hero__instrument margin" data-pagefind-ignore>
      <p class="hero__instrument-title ui">{c('home.hero.instrument')}</p>
      <p class="hero__instrument-lede ui">{c('home.hero.instrument.lede')}</p>
      <Instrument {...instrumentAttributes}>
        <div class="lab__fallback">
          <FlagsSnapshot locale={locale} events={['play', 'pause']} />
          <p class="lab__noscript">{instrument.noscript}</p>
          {instrument.link !== null && (
            <p class="lab__open">
              <a href={instrument.link.href}>{instrument.link.text}</a>
            </p>
          )}
        </div>
      </Instrument>
    </div>
  </section>

  <div class="page-grid">
    <section class="home-section wide" aria-labelledby="axes-title" data-pagefind-ignore>
      <h2 id="axes-title" class="section-title">
        {c('home.axes.title')}
      </h2>
      <p class="section-lede">{c('home.axes.lede')}</p>
      <ul class="axes" role="list">
        {axes.map(({ axis, disciplines, latest: work }) => (
          <li class="axis" data-reveal>
            <svg class="axis__glyph" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
              <use href={`#axis-${axis}`} />
            </svg>
            <h3 class="axis__title">{sc(`axis.${axis}.title`)}</h3>
            <p class="axis__body">{sc(`axis.${axis}.body`)}</p>
            <ul class="axis__disciplines ui" role="list">
              {disciplines.map((d) => (
                <li>
                  <a href={href({ kind: 'discipline', discipline: d }, locale)}>{r(`domain.${d}`)}</a>
                </li>
              ))}
            </ul>
            {work !== undefined && (
              <p class="axis__links ui">
                <span class="axis__latest">{c('home.axes.latest')}</span>
                <a href={work.href}>{work.title}</a>
              </p>
            )}
          </li>
        ))}
      </ul>
      <a class="more-link" href={href({ kind: 'scope' }, locale)}>
        {c('home.axes.link')}
        <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <use href="#ui-arrow" />
        </svg>
      </a>
    </section>

    {recent.length > 0 && (
      <section class="home-section" aria-labelledby="latest-title" data-pagefind-ignore>
        <h2 id="latest-title" class="section-title">
          {c('home.latest.title')}
        </h2>
        <ul class="entry-list" role="list">
          {recent.map((e) => (
            <li class="entry" data-reveal>
              <h3 class="entry__title">
                <a href={href(routeOfEssay(e), locale)}>{e.data.title}</a>
              </h3>
              <p class="entry__description">{e.data.description}</p>
              <p class="entry__meta ui">
                <StratumMark stratum={e.data.stratum} locale={locale} size="s" />
                <span class="entry__domains">{runIn(e.data.domains.slice(0, 3).map((d) => r(`domain.${d}`)))}</span>
                <time datetime={e.data.published.toISOString().slice(0, 10)}>
                  {t('date.published', { date: formatDate(locale, e.data.published) })}
                </time>
              </p>
            </li>
          ))}
        </ul>
        <a class="more-link" href={href({ kind: 'essays' }, locale)}>
          {c('home.latest.all')}
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <use href="#ui-arrow" />
          </svg>
        </a>
      </section>
    )}

    <section class="home-section wide" aria-labelledby="bridge-title" data-pagefind-ignore>
      <h2 id="bridge-title" class="section-title">
        {c('home.bridge.title')}
      </h2>
      <p class="section-lede">{c('home.bridge.lede')}</p>
      <div class="bridge__scene">
        <SimplexScene locale={locale} />
      </div>
      <ol class="bridge" role="list">
        {bridge.map(({ stratum, spec, data }) => (
          <li class="bridge__step" data-stratum={stratum} data-reveal>
            <span class="bridge__node" aria-hidden="true">
              <svg focusable="false" viewBox="0 0 24 24">
                <use href={`#${spec.glyph}`} />
              </svg>
            </span>
            <p class="bridge__step-label ui">{c('home.bridge.step', { n: spec.ordinal + 1, total: STRATA.length })}</p>
            <h3 class="bridge__heading">
              <a class="bridge__link" href={href({ kind: 'stratum', stratum }, locale)}>
                <span class="bridge__title">{data.title}</span>
              </a>
            </h3>
            <span class="bridge__simplex ui">{c(`simplex.${spec.simplex}`)}</span>
            <dl class="bridge__facts">
              <dt class="ui">{c('home.bridge.question')}</dt>
              <dd class="bridge__question">{data.question}</dd>
              <dt class="ui">{c('home.bridge.method')}</dt>
              <dd>{data.method}</dd>
            </dl>
          </li>
        ))}
      </ol>
    </section>

    <div class="home-section teasers wide" data-pagefind-ignore>
      <section class="teaser" aria-labelledby="labs-title" data-reveal>
        <svg class="teaser__glyph" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <use href={`#${FORM_GLYPH.lab}`}></use>
        </svg>
        <h2 id="labs-title" class="teaser__title">
          {c('home.labs.title')}
        </h2>
        <p class="teaser__body">{c('home.labs.body')}</p>
        {labNames.length > 0 && (
          <ul class="teaser__list" role="list">
            {labNames.map((l) => (
              <li>
                <a href={href(routeOfLab(l), locale)}>{l.data.title}</a>
              </li>
            ))}
          </ul>
        )}
        <a class="more-link" href={href({ kind: 'labs' }, locale)}>
          {c('home.labs.link')}
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <use href="#ui-arrow"></use>
          </svg>
        </a>
      </section>
      <section class="teaser" aria-labelledby="ontology-title" data-reveal>
        <svg class="teaser__glyph" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <use href={`#${FORM_GLYPH.map}`}></use>
        </svg>
        <h2 id="ontology-title" class="teaser__title">
          {c('home.ontology.title')}
        </h2>
        <p class="teaser__body">{c('home.ontology.body')}</p>
        <p class="teaser__links">
          <a class="more-link" href={href({ kind: 'ontology' }, locale)}>
            {c('home.ontology.link')}
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
              <use href="#ui-arrow"></use>
            </svg>
          </a>
          <a class="more-link" href={asset('ontology.jsonld')} type="application/ld+json">
            {c('home.ontology.data')}
          </a>
        </p>
      </section>
      <section class="teaser" aria-labelledby="formulas-title" data-reveal>
        <svg class="teaser__glyph" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <use href="#form-formula"></use>
        </svg>
        <h2 id="formulas-title" class="teaser__title">
          {c('home.formulas.title')}
        </h2>
        <p class="teaser__body">{c('home.formulas.body')}</p>
        <p class="teaser__links">
          <a class="more-link" href={href({ kind: 'formulas' }, locale)}>
            {c('home.formulas.link')}
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
              <use href="#ui-arrow"></use>
            </svg>
          </a>
          <a class="more-link" href={asset('formulas.json')} type="application/json">
            {c('home.formulas.data')}
          </a>
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
