---
/**
 * Home page (one per locale).
 *
 *   hero      title + tagline over the four simplices in depth (<ft-depth-scene>)
 *             and the ambient field host (<ft-ambient-field>, labs workstream)
 *   bridge    the four strata as a path, each with its guiding question and
 *             method, linking to the stratum pages
 *   latest    the most recent essays of this locale (section omitted when empty)
 *   teasers   lab and ontology
 *
 * Everything is static HTML and reads completely without JavaScript and with
 * reduced motion; scroll only adds parallax and a gentle reveal (motion.css).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SimplexScene from '../../components/chrome/SimplexScene.astro';
import StratumMark from '../../components/chrome/StratumMark.astro';
import common from '../../core/i18n/catalogs/common.ts';
import chrome from '../../core/i18n/catalogs/chrome.ts';
import reading from '../../core/i18n/catalogs/reading.ts';
import { asset, formatDate, href, localeStaticPaths, useTranslations } from '../../adapters/astro/i18n.ts';
import {
  alternatesForAll,
  concepts,
  essays,
  labs,
  routeOfConcept,
  routeOfEssay,
  routeOfLab,
  strata,
  type Essay,
} from '../../adapters/astro/content.ts';
import { localeCodec, type Locale } from '../../core/domain/locale.ts';
import { STRATA, STRATUM_SPECS } from '../../core/domain/strata.ts';
import { FORM_GLYPH } from '../../core/domain/facets.ts';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { readonly locale: Locale };
const t = useTranslations(common, locale);
const c = useTranslations(chrome, locale);
const r = useTranslations(reading, locale);

/** How many essays the home page lists; the full list lives in the essays index. */
const LATEST = 5;
/** How many labs the teaser names. */
const LAB_NAMES = 3;

const [strataEntries, latest, allLabs, allConcepts] = await Promise.all([
  strata(locale),
  essays(locale),
  labs(locale),
  concepts(),
]);
const bridge = STRATA.map((s) => {
  const entry = strataEntries.find((e) => e.data.stratum === s);
  if (entry === undefined) throw new Error(`[home] missing src/content/strata entry for ${s} (${locale})`);
  return { stratum: s, spec: STRATUM_SPECS[s], data: entry.data };
});
const essayByKey = new Map<string, Essay>(latest.map((e) => [e.data.translationKey, e]));
const conceptById = new Map(allConcepts.map((entry) => [entry.id, entry]));

const essayLink = (key: string): { readonly href: string; readonly label: string } => {
  const entry = essayByKey.get(key);
  if (entry === undefined) throw new Error(`[home] missing essay "${key}" (${locale})`);
  return { href: href(routeOfEssay(entry), locale), label: entry.data.title };
};
const conceptLink = (id: string): { readonly href: string; readonly label: string } => {
  const entry = conceptById.get(id);
  if (entry === undefined) throw new Error(`[home] missing concept "${id}"`);
  return { href: href(routeOfConcept(entry, locale), locale), label: entry.data.prefLabel[locale] };
};

const axes = [
  {
    id: 'software',
    glyph: 'axis-software',
    title: c('home.axes.software.title'),
    body: c('home.axes.software.body'),
    essay: essayLink('changing-without-breaking'),
    concept: conceptLink('information-hiding'),
  },
  {
    id: 'optimization',
    glyph: 'axis-optimization',
    title: c('home.axes.optimization.title'),
    body: c('home.axes.optimization.body'),
    essay: essayLink('the-optimum-is-the-enemy-of-the-deadline'),
    concept: conceptLink('combinatorial-optimization'),
  },
  {
    id: 'systems',
    glyph: 'axis-systems',
    title: c('home.axes.systems.title'),
    body: c('home.axes.systems.body'),
    essay: essayLink('the-record-is-not-the-thing'),
    concept: conceptLink('information-system'),
  },
  {
    id: 'philosophy',
    glyph: 'axis-philosophy',
    title: c('home.axes.philosophy.title'),
    body: c('home.axes.philosophy.body'),
    essay: essayLink('from-sign-to-information'),
    concept: conceptLink('sign'),
  },
] as const;

const recent = latest.slice(0, LATEST);
const labNames = allLabs.slice(0, LAB_NAMES);
const feed = asset(`${localeCodec.encode(locale)}/rss.xml`);
---

<BaseLayout
  locale={locale}
  title={t('site.name')}
  description={t('site.description')}
  alternates={alternatesForAll(() => ({ kind: 'home' }))}
>
  <link slot="head" rel="alternate" type="application/rss+xml" title={c('feed.title')} href={feed} />

  <section class="hero page-grid" aria-labelledby="home-title">
    <ft-ambient-field
      class="hero__ambient"
      data-daypart-aware
      aria-hidden="true"
      role="presentation"
    ></ft-ambient-field>
    <div class="hero__text">
      <h1 id="home-title" class="hero__title">
        {t('site.name')}
      </h1>
      <p class="hero__tagline">{t('site.tagline')}</p>
    </div>
    <SimplexScene locale={locale} />
  </section>

  <div class="page-grid">
    <section class="home-section wide" aria-labelledby="bridge-title" data-pagefind-ignore>
      <h2 id="bridge-title" class="section-title">
        {c('home.bridge.title')}
      </h2>
      <p class="section-lede">{c('home.bridge.lede')}</p>
      <ol class="bridge" role="list">
        {bridge.map(({ stratum, spec, data }) => (
          <li class="bridge__step" data-stratum={stratum} data-reveal>
            <span class="bridge__node" aria-hidden="true">
              <svg focusable="false" viewBox="0 0 24 24">
                <use href={`#${spec.glyph}`} />
              </svg>
            </span>
            <p class="bridge__step-label ui">{c('home.bridge.step', { n: spec.ordinal + 1, total: STRATA.length })}</p>
            <h3 class="bridge__heading">
              <a class="bridge__link" href={href({ kind: 'stratum', stratum }, locale)}>
                <span class="bridge__title">{data.title}</span>
              </a>
            </h3>
            <span class="bridge__simplex ui">{c(`simplex.${spec.simplex}`)}</span>
            <dl class="bridge__facts">
              <dt class="ui">{c('home.bridge.question')}</dt>
              <dd class="bridge__question">{data.question}</dd>
              <dt class="ui">{c('home.bridge.method')}</dt>
              <dd>{data.method}</dd>
            </dl>
          </li>
        ))}
      </ol>
    </section>

    <section class="home-section wide" aria-labelledby="axes-title" data-pagefind-ignore>
      <h2 id="axes-title" class="section-title">
        {c('home.axes.title')}
      </h2>
      <p class="section-lede">{c('home.axes.lede')}</p>
      <ul class="axes" role="list">
        {axes.map((axis) => (
          <li class="axis" data-reveal>
            <svg class="axis__glyph" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
              <use href={`#${axis.glyph}`} />
            </svg>
            <h3 class="axis__title">{axis.title}</h3>
            <p class="axis__body">{axis.body}</p>
            <p class="axis__links ui">
              <a href={axis.essay.href}>{axis.essay.label}</a>
              <a href={axis.concept.href}>§ {axis.concept.label}</a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    {recent.length > 0 && (
      <section class="home-section" aria-labelledby="latest-title" data-pagefind-ignore>
        <h2 id="latest-title" class="section-title">
          {c('home.latest.title')}
        </h2>
        <ul class="entry-list" role="list">
          {recent.map((e) => (
            <li class="entry" data-reveal>
              <h3 class="entry__title">
                <a href={href(routeOfEssay(e), locale)}>{e.data.title}</a>
              </h3>
              <p class="entry__description">{e.data.description}</p>
              <p class="entry__meta ui">
                <StratumMark stratum={e.data.stratum} locale={locale} size="s" />
                <span class="entry__domains">
                  {e.data.domains
                    .slice(0, 3)
                    .map((d) => r(`domain.${d}`))
                    .join(' · ')}
                </span>
                <time datetime={e.data.published.toISOString().slice(0, 10)}>
                  {t('date.published', { date: formatDate(locale, e.data.published) })}
                </time>
              </p>
            </li>
          ))}
        </ul>
        <a class="more-link" href={href({ kind: 'essays' }, locale)}>
          {c('home.latest.all')}
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <use href="#ui-arrow" />
          </svg>
        </a>
      </section>
    )}

    <div class="home-section teasers wide" data-pagefind-ignore>
      <section class="teaser" aria-labelledby="labs-title" data-reveal>
        <svg class="teaser__glyph" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <use href={`#${FORM_GLYPH.lab}`}></use>
        </svg>
        <h2 id="labs-title" class="teaser__title">
          {c('home.labs.title')}
        </h2>
        <p class="teaser__body">{c('home.labs.body')}</p>
        {labNames.length > 0 && (
          <ul class="teaser__list" role="list">
            {labNames.map((l) => (
              <li>
                <a href={href(routeOfLab(l), locale)}>{l.data.title}</a>
              </li>
            ))}
          </ul>
        )}
        <a class="more-link" href={href({ kind: 'labs' }, locale)}>
          {c('home.labs.link')}
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <use href="#ui-arrow"></use>
          </svg>
        </a>
      </section>
      <section class="teaser" aria-labelledby="ontology-title" data-reveal>
        <svg class="teaser__glyph" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <use href={`#${FORM_GLYPH.map}`}></use>
        </svg>
        <h2 id="ontology-title" class="teaser__title">
          {c('home.ontology.title')}
        </h2>
        <p class="teaser__body">{c('home.ontology.body')}</p>
        <p class="teaser__links">
          <a class="more-link" href={href({ kind: 'ontology' }, locale)}>
            {c('home.ontology.link')}
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
              <use href="#ui-arrow"></use>
            </svg>
          </a>
          <a class="more-link" href={asset('ontology.jsonld')} type="application/ld+json">
            {c('home.ontology.data')}
          </a>
        </p>
      </section>
      <section class="teaser" aria-labelledby="formulas-title" data-reveal>
        <svg class="teaser__glyph" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <use href="#form-formula"></use>
        </svg>
        <h2 id="formulas-title" class="teaser__title">
          {c('home.formulas.title')}
        </h2>
        <p class="teaser__body">{c('home.formulas.body')}</p>
        <p class="teaser__links">
          <a class="more-link" href={href({ kind: 'formulas' }, locale)}>
            {c('home.formulas.link')}
            <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
              <use href="#ui-arrow"></use>
            </svg>
          </a>
          <a class="more-link" href={asset('formulas.json')} type="application/json">
            {c('home.formulas.data')}
          </a>
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
