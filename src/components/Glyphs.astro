---
/**
 * SVG symbol sprite, inlined once per page (≈1 KB) and referenced with
 * <use href="#id">. Symbology: strata are k-simplices (see core/domain/strata.ts);
 * forms are typographic marks of the scholarly tradition (core/domain/facets.ts).
 * Strokes use currentColor so glyphs inherit text colour and forced-colors.
 */
---

<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" style="position:absolute;inline-size:0;block-size:0;overflow:hidden">
  <defs>
    <!-- 0-simplex: the point — a question without extension -->
    <symbol id="simplex-0" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="3.2" fill="currentColor" />
    </symbol>
    <!-- 1-simplex: the segment — a relation between two terms -->
    <symbol id="simplex-1" viewBox="0 0 24 24">
      <path d="M5 17 19 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <circle cx="5" cy="17" r="2.2" fill="currentColor" />
      <circle cx="19" cy="7" r="2.2" fill="currentColor" />
    </symbol>
    <!-- 2-simplex: the triangle — a closed structure, the minimal rigid figure -->
    <symbol id="simplex-2" viewBox="0 0 24 24">
      <path d="M12 4.5 20 18.5H4Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <circle cx="12" cy="4.5" r="2" fill="currentColor" />
      <circle cx="20" cy="18.5" r="2" fill="currentColor" />
      <circle cx="4" cy="18.5" r="2" fill="currentColor" />
    </symbol>
    <!-- 3-simplex: the tetrahedron — a solid, the concrete artefact (hidden edge dashed) -->
    <symbol id="simplex-3" viewBox="0 0 24 24">
      <path d="M12 3.5 20.5 17 13.5 20.5 3.5 16Z M12 3.5 13.5 20.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      <path d="M3.5 16 20.5 17" fill="none" stroke="currentColor" stroke-width="1.1" stroke-dasharray="1.6 1.8" />
      <circle cx="12" cy="3.5" r="1.8" fill="currentColor" />
      <circle cx="20.5" cy="17" r="1.8" fill="currentColor" />
      <circle cx="13.5" cy="20.5" r="1.8" fill="currentColor" />
      <circle cx="3.5" cy="16" r="1.8" fill="currentColor" />
    </symbol>
  </defs>
</svg>
