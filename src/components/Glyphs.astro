---
/**
 * SVG symbol sprite, inlined once per page (≈3 KB) and referenced with
 * <use href="#id">. Symbology: strata are k-simplices (see core/domain/strata.ts);
 * forms are typographic marks of the scholarly tradition (core/domain/facets.ts),
 * redrawn as paths so they never depend on a font or turn into emoji.
 * All symbols share a 24-unit viewBox and a 1.6 stroke; strokes and fills use
 * currentColor so glyphs inherit text colour and forced-colors palettes.
 *
 * The sprite also carries the colour-vision-deficiency simulation filters used
 * by the reader preference "cvd" (applied with CSS filter:url(#cvd-…) in
 * src/styles/components/chrome.css). Matrix values come from the pure model
 * (Machado, Oliveira & Fernandes 2009; src/core/design/cvd.ts). The sprite is
 * hidden by zero size, not display:none, because filters inside an unrendered
 * SVG are ignored by some engines.
 */
import { CVD_TYPES, feColorMatrixValues } from '../core/design/cvd.ts';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  focusable="false"
  class="glyph-sprite"
  style="position:absolute;inline-size:0;block-size:0;overflow:hidden"
>
  <defs>
    <!-- 0-simplex: the point — a question without extension -->
    <symbol id="simplex-0" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="3.2" fill="currentColor"></circle>
    </symbol>
    <!-- 1-simplex: the segment — a relation between two terms -->
    <symbol id="simplex-1" viewBox="0 0 24 24">
      <path d="M5 17 19 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
      <circle cx="5" cy="17" r="2.2" fill="currentColor"></circle>
      <circle cx="19" cy="7" r="2.2" fill="currentColor"></circle>
    </symbol>
    <!-- 2-simplex: the triangle — a closed structure, the minimal rigid figure -->
    <symbol id="simplex-2" viewBox="0 0 24 24">
      <path d="M12 4.5 20 18.5H4Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
      <circle cx="12" cy="4.5" r="2" fill="currentColor"></circle>
      <circle cx="20" cy="18.5" r="2" fill="currentColor"></circle>
      <circle cx="4" cy="18.5" r="2" fill="currentColor"></circle>
    </symbol>
    <!-- 3-simplex: the tetrahedron — a solid, the concrete artefact (hidden edge dashed) -->
    <symbol id="simplex-3" viewBox="0 0 24 24">
      <path
        d="M12 3.5 20.5 17 13.5 20.5 3.5 16Z M12 3.5 13.5 20.5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
      <path d="M3.5 16 20.5 17" fill="none" stroke="currentColor" stroke-width="1.1" stroke-dasharray="1.6 1.8"></path>
      <circle cx="12" cy="3.5" r="1.8" fill="currentColor"></circle>
      <circle cx="20.5" cy="17" r="1.8" fill="currentColor"></circle>
      <circle cx="13.5" cy="20.5" r="1.8" fill="currentColor"></circle>
      <circle cx="3.5" cy="16" r="1.8" fill="currentColor"></circle>
    </symbol>

    <!-- Form marks -->
    <!-- ¶ pilcrow (essay): the argument — a filled bowl hanging from a double stem; the bar ends at the second stem -->
    <symbol id="form-essay" viewBox="0 0 24 24">
      <path d="M13.2 4.5h-2.6a3.9 3.9 0 0 0 0 7.8h2.6Z" fill="currentColor"></path>
      <path
        d="M13.2 4.5v15M16.6 4.5v15M10.6 4.5h6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
    </symbol>
    <!-- † dagger (note): the scholar's mark for a note — a stem with a slightly flared crossbar -->
    <symbol id="form-note" viewBox="0 0 24 24">
      <path
        d="M12 3.5v17M7.2 8.4c1.6-.4 3.2-.6 4.8-.6s3.2.2 4.8.6"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
    </symbol>
    <!-- Flask (lab): an alembic reduced to its outline, with a liquid line -->
    <symbol id="form-lab" viewBox="0 0 24 24">
      <path
        d="M9.6 3.8v5.6L4.6 18.2a1.5 1.5 0 0 0 1.3 2.3h12.2a1.5 1.5 0 0 0 1.3-2.3l-5-8.8V3.8M8.4 3.8h7.2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path d="M7.1 14.6h9.8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </symbol>
    <!-- § section sign (concept): the entry of a definition — two interlocked S-curves -->
    <symbol id="form-concept" viewBox="0 0 24 24">
      <path
        d="M15.6 6.4c-.5-1.6-1.9-2.6-3.6-2.6-2 0-3.5 1.2-3.5 2.9 0 3.5 7 3.1 7 6.9 0 1.4-1 2.5-2.5 2.9M8.4 17.6c.5 1.6 1.9 2.6 3.6 2.6 2 0 3.5-1.2 3.5-2.9 0-3.5-7-3.1-7-6.9 0-1.4 1-2.5 2.5-2.9"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
    </symbol>
    <!-- ⌖ position indicator (map): a reticle -->
    <symbol id="form-map" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path
        d="M12 2.8v5M12 16.2v5M2.8 12h5M16.2 12h5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
      <circle cx="12" cy="12" r="1.2" fill="currentColor"></circle>
    </symbol>

    <!-- Interface marks (same grid and stroke) -->
    <symbol id="ui-search" viewBox="0 0 24 24">
      <circle cx="10.5" cy="10.5" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path d="m15 15 5.2 5.2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </symbol>
    <symbol id="ui-prefs" viewBox="0 0 24 24">
      <path
        d="M4 7.5h8.6M17.4 7.5H20M4 16.5h2.6M11.4 16.5H20"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"></path>
      <circle cx="15" cy="7.5" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <circle cx="9" cy="16.5" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
    </symbol>
    <symbol id="ui-menu" viewBox="0 0 24 24">
      <path d="M4 8h16M4 16h16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </symbol>
    <symbol id="ui-close" viewBox="0 0 24 24">
      <path d="m6.5 6.5 11 11m0-11-11 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </symbol>
    <symbol id="ui-arrow" viewBox="0 0 24 24">
      <path
        d="M4 12h15m-5-5 5 5-5 5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </symbol>
    <symbol id="ui-feed" viewBox="0 0 24 24">
      <circle cx="6" cy="18" r="1.8" fill="currentColor"></circle>
      <path d="M5 11.2a7.8 7.8 0 0 1 7.8 7.8M5 5a14 14 0 0 1 14 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
    </symbol>
    <symbol id="ui-language" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="8.2" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
      <path
        d="M3.8 12h16.4M12 3.8c2.3 2.3 3.4 5 3.4 8.2s-1.1 5.9-3.4 8.2M12 3.8C9.7 6.1 8.6 8.8 8.6 12s1.1 5.9 3.4 8.2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"></path>
    </symbol>

    <!-- Colour-vision simulation (Machado et al. 2009), linearRGB as the model requires -->
    {
      CVD_TYPES.map((type) => (
        <filter id={`cvd-${type}`} color-interpolation-filters="linearRGB">
          <feColorMatrix type="matrix" values={feColorMatrixValues(type)} />
        </filter>
      ))
    }
  </defs>
</svg>
