---
/**
 * KaTeX stylesheet and fonts — only for pages that render math.
 *
 * Usage (views): `{remarkPluginFrontmatter.hasMath && <MathAssets slot="head" />}`
 * inside <BaseLayout>; the latex stage sets `hasMath` (src/adapters/unified/remark-latex.ts).
 *
 * Why `?url` instead of `import 'katex/dist/katex.min.css'`: a plain CSS import
 * is bundled into the stylesheet of EVERY page whose module graph reaches this
 * component, whether or not the page renders it. With `?url`, Vite runs the
 * CSS through its pipeline as a standalone asset — the `url(fonts/…)` of every
 * @font-face is rewritten to the hashed font files, which are emitted too — and
 * the import only yields that asset's URL. A <link> exists in the HTML only
 * where this component is rendered. Verified with `astro build`: a page that
 * imports MathAssets but does not render it references no KaTeX file; a page
 * that renders it links /_astro/katex.min.<hash>.css whose 60 font URLs all
 * resolve in dist/.
 *
 * CSP (security.csp in astro.config.ts): an external same-origin stylesheet
 * and fonts are covered by `style-src 'self'` and `font-src 'self'`; nothing
 * inline is emitted. KaTeX's own `style=""` attributes are covered by
 * `style-src-attr 'unsafe-inline'`.
 *
 * The two preloaded faces (Main-Regular, Math-Italic) are used by virtually
 * every formula; preloading them avoids a flash of fallback glyphs, as KaTeX
 * declares `font-display: block`. Its stylesheet stays outside the cascade
 * layers on purpose: vendor rules must win over the site's reset for KaTeX's
 * own elements (see src/styles/components/latex.css).
 */
import katexStylesheet from 'katex/dist/katex.min.css?url';
import mainRegular from 'katex/dist/fonts/KaTeX_Main-Regular.woff2?url';
import mathItalic from 'katex/dist/fonts/KaTeX_Math-Italic.woff2?url';
---

<link rel="preload" as="font" type="font/woff2" href={mainRegular} crossorigin="anonymous" />
<link rel="preload" as="font" type="font/woff2" href={mathItalic} crossorigin="anonymous" />
<link rel="stylesheet" href={katexStylesheet} />
