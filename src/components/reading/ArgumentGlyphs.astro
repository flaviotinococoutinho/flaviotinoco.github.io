---
/**
 * SVG symbol sprite of the argument kinds (one <symbol id="arg-<kind>"> each),
 * drawn from the single geometric source src/core/reading/argument.ts (GLYPHS),
 * shared with the heading marks the reading stage emits. Shapes, not colours,
 * carry the kind (WCAG 1.4.1): the signs of logic, in pairs (premise ∵ / conclusion ∴,
 * claim ⊢ / application ⊨, objection ¬ / reply ¬¬), never the geometric figures that
 * stand for the strata. Render once per page that shows an argument map; strokes use
 * currentColor (forced-colors safe), set once on a group and inherited by the paths.
 */
import {
  ARGUMENT_KINDS,
  GLYPHS,
  GLYPH_PAINT,
  GLYPH_VIEWBOX,
  glyphSymbolId,
  pathPaint,
} from '../../core/reading/argument.ts';
---

<svg class="reading-sprite" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
  <defs>
    {ARGUMENT_KINDS.map((kind) => (
      <symbol id={glyphSymbolId(kind)} viewBox={GLYPH_VIEWBOX}>
        <g
          fill={GLYPH_PAINT.fill}
          stroke={GLYPH_PAINT.stroke}
          stroke-width={GLYPH_PAINT.strokeWidth}
          stroke-linecap={GLYPH_PAINT.strokeLinecap}
          stroke-linejoin={GLYPH_PAINT.strokeLinejoin}
        >
          {GLYPHS[kind].map((p) => (
            <path d={p.d} fill={pathPaint(p).fill} stroke-width={pathPaint(p).strokeWidth} />
          ))}
        </g>
      </symbol>
    ))}
  </defs>
</svg>
