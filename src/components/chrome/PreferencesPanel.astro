---
/**
 * Reader preferences panel: a native popover (popovertarget on the header
 * button opens it without script, light-dismiss and Esc included) with the
 * semantics of a non-modal dialog.
 *
 * The panel is a shell: title, close button, intro, an empty form with the
 * reset button, and the live status. The radio groups (PREFERENCE_KEYS ×
 * PREFERENCE_DOMAINS, labels from the chrome catalog) are served once per
 * locale as /<lang>/preferences.json (ADR 0009) and built by <ft-preferences>
 * the first time the panel opens — the element sits inside the popover, so
 * its module loads only then. Until the form is built (data-ready) it is kept
 * invisible, so a stale default never flashes; without JavaScript the opening
 * button is not shown at all and the site follows the system settings
 * (prefers-color-scheme, prefers-contrast, prefers-reduced-motion, browser zoom).
 */
import type { Locale } from '../../core/domain/locale.ts';
import { localeCodec } from '../../core/domain/locale.ts';
import chrome from '../../core/i18n/catalogs/chrome.ts';
import { asset, useTranslations } from '../../adapters/astro/i18n.ts';

export interface Props {
  readonly locale: Locale;
}

const { locale } = Astro.props;
const c = useTranslations(chrome, locale);
---

<div id="ft-prefs" class="prefs ui" popover role="dialog" aria-labelledby="ft-prefs-title">
  <ft-preferences class="prefs__body" data-source={asset(`${localeCodec.encode(locale)}/preferences.json`)}>
    <div class="prefs__head">
      <h2 id="ft-prefs-title" class="prefs__title">
        {c('prefs.title')}
      </h2>
      <button type="button" class="tool" popovertarget="ft-prefs" popovertargetaction="hide">
        <svg class="tool__icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
          <use href="#ui-close"></use>
        </svg>
        <span class="visually-hidden">{c('prefs.close')}</span>
      </button>
    </div>
    <p class="prefs__intro">{c('prefs.intro')}</p>
    <form class="prefs__form">
      <button type="button" class="prefs__reset" data-reset data-announce={c('prefs.resetDone')}>
        {c('prefs.reset')}
      </button>
    </form>
    <p class="visually-hidden" role="status"></p>
  </ft-preferences>
</div>
