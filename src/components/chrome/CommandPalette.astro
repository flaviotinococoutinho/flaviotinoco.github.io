---
/**
 * Command palette dialog (opened by <ft-palette-trigger> in the header).
 *
 * The dialog is a shell: field, close button, live status, list and hint. The
 * quick-navigation entries (home, sections, the four strata, about, colophon)
 * are the same on every page of a locale, so they are served once as
 * /<lang>/palette.json (ADR 0009) and fetched by <ft-command-palette>, which
 * sits INSIDE the dialog on purpose: its module, the entries and Pagefind load
 * only when the dialog is first opened. The one page-specific entry — this
 * page in the other language — stays here as an ordinary link, with the same
 * data-* the element reads for ranking.
 */
import type { Locale } from '../../core/domain/locale.ts';
import { localeCodec } from '../../core/domain/locale.ts';
import common from '../../core/i18n/catalogs/common.ts';
import chrome from '../../core/i18n/catalogs/chrome.ts';
import { asset, href, useTranslations } from '../../adapters/astro/i18n.ts';
import type { LanguageSwitch } from '../../core/chrome/nav.ts';

export interface Props {
  readonly locale: Locale;
  readonly languageSwitch: LanguageSwitch;
}

const { locale, languageSwitch: sw } = Astro.props;
const c = useTranslations(chrome, locale);
const other = useTranslations(common, sw.locale);

const language = {
  label: sw.isTranslation ? c('palette.otherLanguage') : c('palette.otherHome'),
  href: sw.href,
  kind: c('palette.kind.language'),
  keywords: `${other('lang.name')} ${other('lang.switch')}`,
  glyph: 'ui-language',
  hreflang: sw.locale,
};

const messages = {
  zero: c('palette.results.zero'),
  one: c('palette.results.one'),
  other: c('palette.results.other'),
  indexMissing: c('palette.indexMissing'),
  text: c('palette.kind.text'),
};
---

<dialog id="ft-palette" class="palette ui" aria-labelledby="ft-palette-title" closedby="any">
  <ft-command-palette
    class="palette__body"
    data-messages={JSON.stringify(messages)}
    data-locale-prefix={href({ kind: 'home' }, locale)}
    data-entries={asset(`${localeCodec.encode(locale)}/palette.json`)}
  >
    <h2 id="ft-palette-title" class="visually-hidden">
      {c('palette.title')}
    </h2>
    <div class="palette__field">
      <svg class="palette__field-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
        <use href="#ui-search"></use>
      </svg>
      <label for="ft-palette-input" class="visually-hidden">
        {c('palette.label')}
      </label>
      <input
        id="ft-palette-input"
        class="palette__input"
        type="search"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
        placeholder={c('palette.placeholder')}
        aria-describedby="ft-palette-hint"
        autofocus
      />
      <form method="dialog" class="palette__close-form">
        <button type="submit" class="tool palette__close">
          <svg class="tool__icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <use href="#ui-close"></use>
          </svg>
          <span class="visually-hidden">{c('palette.close')}</span>
        </button>
      </form>
    </div>
    <p class="palette__status" role="status"></p>
    <ul class="palette__list" id="ft-palette-list" role="list" aria-label={c('palette.list')}>
      <li class="palette__item">
        <a
          class="palette__link"
          href={language.href}
          hreflang={language.hreflang}
          data-label={language.label}
          data-kind={language.kind}
          data-keywords={language.keywords}
          data-glyph={language.glyph}
        >
          <svg class="palette__glyph" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <use href={`#${language.glyph}`} />
          </svg>
          <span class="palette__label">{language.label}</span>
          <span class="palette__kind">{language.kind}</span>
        </a>
      </li>
    </ul>
    {/* The field's accessible description: it names only the shortcuts that work. With the
        single-key shortcut turned off (data-shortcut="off", WCAG 2.1.4) CSS swaps the two
        renderings; display: none removes the hidden one from the description too. */}
    <p id="ft-palette-hint" class="palette__hint">
      {c('palette.hint')} · <span class="palette__keys palette__keys--single">{c('search.keys')}</span>
      <span class="palette__keys palette__keys--chord">{c('search.keysChord')}</span>
    </p>
  </ft-command-palette>
</dialog>
