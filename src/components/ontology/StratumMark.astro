---
/**
 * Stratum mark: the simplex glyph of the stratum AND its label — never colour
 * alone (WCAG 1.4.1). The glyph comes from the page's SVG sprite (Glyphs.astro).
 */
import type { Locale } from '../../core/domain/locale.ts';
import { STRATUM_SPECS, type Stratum } from '../../core/domain/strata.ts';
import { stratumLabel } from '../../core/ontology/index.ts';

export interface Props {
  readonly stratum: Stratum;
  readonly locale: Locale;
  /** Visually hide the label (it stays in the accessibility tree), for dense lists. */
  readonly compact?: boolean;
}
const { stratum, locale, compact = false } = Astro.props;
---

<span class:list={['stratum-mark', `stratum-mark--${stratum}`, { 'stratum-mark--compact': compact }]} data-stratum={stratum}>
  <svg class="glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><use href={`#${STRATUM_SPECS[stratum].glyph}`}></use></svg>
  <span class:list={['stratum-mark__label', { 'visually-hidden': compact }]}>{stratumLabel(locale, stratum)}</span>
</span>
