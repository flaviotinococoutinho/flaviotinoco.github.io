---
/**
 * Local navigation of the ontology section: the overview (map and tree) and
 * the three pages it was split into so that no page outgrows the HTML budget
 * (ADR 0009) — structure, comparison and measures, lattice of the works.
 * The page being shown is marked with aria-current="page" (core/chrome/nav.ts).
 */
import type { Locale } from '../../core/domain/locale.ts';
import { ONTOLOGY_PAGES, type OntologyPage } from '../../core/i18n/routes.ts';
import { href } from '../../adapters/astro/i18n.ts';
import { ontologyText } from './text.ts';

export interface Props {
  readonly locale: Locale;
  readonly current: 'overview' | OntologyPage;
}
const { locale, current } = Astro.props;
const { t } = ontologyText(locale);
const items = [
  { key: 'overview' as const, label: t('ontology.nav.overview'), href: href({ kind: 'ontology' }, locale) },
  ...ONTOLOGY_PAGES.map((page) => ({
    key: page,
    label: t(`ontology.page.${page}.nav`),
    href: href({ kind: 'ontology-page', page }, locale),
  })),
];
---

<nav class="ontology-nav ui" aria-label={t('ontology.nav.label')}>
  <ul class="ontology__links" role="list">
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={item.key === current ? 'page' : undefined}>
          {item.label}
        </a>
      </li>
    ))}
  </ul>
</nav>
