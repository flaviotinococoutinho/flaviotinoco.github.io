---
/** STUB view — replaced by the owning workstream (ontology). */
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../core/domain/locale.ts';
export interface Props {
  readonly locale: Locale;
  readonly id: string;
}
const { locale } = Astro.props;
---

<BaseLayout
  locale={locale}
  title="ConceptView"
  description="Placeholder page rendered by a view stub until its workstream lands."
  alternates={{}}
  noindex
>
  <div class="page-grid">
    <h1>ConceptView</h1>
  </div>
</BaseLayout>
