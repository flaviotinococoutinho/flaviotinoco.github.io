---
/** STUB view — replaced by the owning workstream (chrome). */
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../core/domain/locale.ts';
export interface Props { readonly locale: Locale; readonly stratum: import('../core/domain/strata.ts').Stratum; }
const { locale } = Astro.props;
---

<BaseLayout locale={locale} title="StratumView" description="Placeholder page rendered by a view stub until its workstream lands." alternates={{}} noindex>
  <div class="page-grid"><h1>StratumView</h1></div>
</BaseLayout>
