---
/**
 * The ontology pages besides the overview (route kind "ontology-page", ADR 0009):
 *
 *   structure   the top level as a table (strata × categories, the anchor target
 *               of the #category-… breadcrumbs) and the relation vocabulary;
 *   comparison  the compare tool, the bridge concepts (betweenness across
 *               strata) and the thematic communities, each with its measure note;
 *   lattice     the formal concept lattice of the works.
 *
 * Each page carries the local navigation of the section; the explorer (map
 * and tree) stays on the overview (OntologyView.astro).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MathAssets from '../components/MathAssets.astro';
import ComparePanel from '../components/ontology/ComparePanel.astro';
import ConceptLink from '../components/ontology/ConceptLink.astro';
import FcaSection from '../components/ontology/FcaSection.astro';
import MeasuresNote from '../components/ontology/MeasuresNote.astro';
import OntologyNav from '../components/ontology/OntologyNav.astro';
import TopLevelGrid from '../components/ontology/TopLevelGrid.astro';
import VocabularyTable from '../components/ontology/VocabularyTable.astro';
import { siteOntology } from '../components/ontology/data.ts';
import { ontologyText } from '../components/ontology/text.ts';
import type { Locale } from '../core/domain/locale.ts';
import type { OntologyPage } from '../core/i18n/routes.ts';
import { alternatesForAll } from '../adapters/astro/content.ts';
import { href } from '../adapters/astro/i18n.ts';

export interface Props {
  readonly locale: Locale;
  readonly page: OntologyPage;
}

const { locale, page } = Astro.props;
const { ontology } = await siteOntology();
const tx = ontologyText(locale);
const { t } = tx;

const crossValue = (id: (typeof ontology.bridges)[number]) => ontology.centrality.crossStrata.get(id) ?? 0;
const nmi = ontology.stats.communities;
const ids = {
  toplevel: 'ontology-toplevel',
  vocabulary: 'ontology-vocabulary',
  compare: 'ontology-compare',
  bridges: 'ontology-bridges',
  communities: 'ontology-communities',
  fca: 'ontology-fca',
} as const;
---

<BaseLayout
  locale={locale}
  title={t(`ontology.page.${page}.title`)}
  description={t(`ontology.page.${page}.description`)}
  alternates={alternatesForAll(() => ({ kind: 'ontology-page', page }))}
>
  {page === 'comparison' && <MathAssets slot="head" />}
  <div class="page-grid ontology">
    <header class="ontology__header">
      <h1>{t(`ontology.page.${page}.title`)}</h1>
      <p class="ontology__lede">{t(`ontology.page.${page}.lede`)}</p>
      <OntologyNav locale={locale} current={page} />
      {page === 'structure' && (
        <ul class="ontology__links ui" role="list">
          <li>
            <a href={href({ kind: 'glossary' }, locale)}>{t('ontology.glossaryLink')}</a>
          </li>
        </ul>
      )}
    </header>

    {page === 'structure' && (
      <>
        <section class="ontology__toplevel wide" aria-labelledby={ids.toplevel}>
          <h2 id={ids.toplevel}>{t('ontology.topLevelHeading')}</h2>
          <p>{t('ontology.topLevelIntro')}</p>
          <TopLevelGrid locale={locale} />
        </section>

        <section class="ontology__vocabulary wide" aria-labelledby={ids.vocabulary}>
          <h2 id={ids.vocabulary}>{t('ontology.vocabularyHeading')}</h2>
          <p>{t('ontology.vocabularyIntro')}</p>
          <VocabularyTable locale={locale} />
        </section>
      </>
    )}

    {page === 'comparison' && (
      <>
        <section class="ontology__compare" aria-labelledby={ids.compare}>
          <h2 id={ids.compare}>{t('ontology.compareHeading')}</h2>
          <ComparePanel locale={locale} />
          <MeasuresNote locale={locale} measures={['ic', 'resnik', 'lin']} />
        </section>

        <section class="ontology__bridges" aria-labelledby={ids.bridges}>
          <h2 id={ids.bridges}>{t('ontology.bridgesHeading')}</h2>
          <p>{t('ontology.bridgesIntro')}</p>
          <ol class="bridge-list">
            {ontology.bridges.map((id) => (
              <li>
                <ConceptLink id={id} locale={locale} showStratum />
                <span class="bridge-list__value ui">{tx.number(crossValue(id))}</span>
              </li>
            ))}
          </ol>
          <MeasuresNote locale={locale} measures={['betweenness']} />
        </section>

        <section class="ontology__communities wide" aria-labelledby={ids.communities}>
          <h2 id={ids.communities}>{t('ontology.communitiesHeading')}</h2>
          <p>{t('ontology.communitiesIntro')}</p>
          <p class="ui ontology__nmi">
            {t('ontology.nmi', { q: tx.number(nmi.modularity), nmi: tx.number(nmi.nmiDomains) })}
          </p>
          <ol class="community-list">
            {ontology.communities.members.map((members, i) => (
              <li class="community-list__item">
                <h3>{t('ontology.communityName', { n: i + 1 })}</h3>
                <ul class="chip-list" role="list">
                  {members.map((id) => (
                    <li>
                      <ConceptLink id={id} locale={locale} />
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
          <MeasuresNote locale={locale} measures={['nmi']} />
        </section>
      </>
    )}

    {page === 'lattice' && (
      <section class="ontology__fca full" aria-labelledby={ids.fca}>
        <div class="ontology__fca-head">
          <h2 id={ids.fca}>{t('ontology.fcaHeading')}</h2>
          <p>{t('ontology.fcaIntro')}</p>
        </div>
        <FcaSection locale={locale} />
      </section>
    )}
  </div>
</BaseLayout>
