---
/** STUB view — replaced by the owning workstream (content). */
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../core/domain/locale.ts';
export interface Props { readonly locale: Locale; readonly pageKey: 'about' | 'colophon'; }
const { locale } = Astro.props;
---

<BaseLayout locale={locale} title="PageView" description="Placeholder page rendered by a view stub until its workstream lands." alternates={{}} noindex>
  <div class="page-grid"><h1>PageView</h1></div>
</BaseLayout>
