root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a hard line break in CommonMark: never strip them silently.
trim_trailing_whitespace = false

[*.tsv]
# Tabs are the field separator of the lexicon files: they carry meaning.
indent_style = tab

[*.rs]
indent_size = 4
