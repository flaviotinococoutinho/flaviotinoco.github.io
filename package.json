{
  "name": "flaviotinoco-site",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm build:wasm && astro dev",
    "build": "pnpm build:wasm && pnpm build:site && pnpm search:index",
    "build:wasm": "node scripts/build-wasm.mjs",
    "preview": "astro preview",
    "search:index": "pagefind --site dist",
    "tokens": "node scripts/tokens.ts",
    "check": "pnpm check:types && pnpm check:lint && pnpm check:format && pnpm check:tokens && pnpm verify:palette && pnpm check:i18n && pnpm test",
    "check:types": "astro check && tsc --noEmit -p tsconfig.json",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:tokens": "node scripts/tokens.ts --check",
    "check:i18n": "node scripts/check-i18n.ts",
    "check:links": "node scripts/check-links.ts dist",
    "check:budgets": "node scripts/check-budgets.ts dist",
    "check:robots": "node scripts/check-robots.ts dist",
    "check:wasm": "cd wasm && cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo clippy --workspace --target wasm32-unknown-unknown -- -D warnings && cargo test --workspace",
    "verify:palette": "node scripts/verify-palette.ts",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ft": "node cli/main.ts",
    "build:site": "node scripts/astro-build-strict.mjs",
    "test:wasm": "vitest run --project wasm",
    "fonts": "python3 -I scripts/fonts/build_fonts.py"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@retorquere/bibtex-parser": "^11.0.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.5",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "apca-w3": "0.1.9",
    "colorjs.io": "0.7.1",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-functional": "^10.0.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "satori": "^0.47.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vfile": "^6.0.3",
    "vitest": "5.0.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "7.3.8",
    "hast-util-to-string": "^3.0.1",
    "hastscript": "^9.0.1",
    "katex": "^0.19.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "unist-util-visit-parents": "^6.0.2"
  }
}
